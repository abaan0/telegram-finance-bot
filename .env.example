# ============================================================
# Telegram Finance Bot
# ============================================================

BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_user_id


# ============================================================
# Google Sheets
# ============================================================

# Path to the Google service account credentials JSON file
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json

SPREADSHEET_ID=your_spreadsheet_id

# Monthly worksheet is selected automatically from the transaction date.
# Existing short names (Aug, Sep) and full names (October) are supported.


# ============================================================
# Gemini AI
# ============================================================

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite


# ============================================================
# Timezone
# ============================================================

TIMEZONE=Asia/Kolkata


# ============================================================
# Run Mode
# ============================================================

# Use 'polling' for local development.
# Use 'webhook' for production deployment.

RUN_MODE=polling


# ============================================================
# Webhook Configuration
# ============================================================

# Only required when RUN_MODE=webhook.
# Example:
# WEBHOOK_URL=https://your-app.onrender.com/<bot-token>

WEBHOOK_URL=
WEBHOOK_SECRET=your-secret


# ============================================================
# Server Port
# ============================================================

# Finance Bot uses port 10001 locally.
# For production, the hosting platform may override this
# using the PORT environment variable.

PORT=10001

# Optional: automatically save only high-confidence natural-language entries.
# Keep false to require Confirm/Cancel for every transaction (recommended initially).
FAST_ENTRY_MODE=false
FAST_ENTRY_MIN_CONFIDENCE=0.92
