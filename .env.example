# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_user_id

# Google Sheets Configuration
SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Timezone
TIMEZONE=Asia/Kolkata

# Run Mode Configuration
# Set to 'polling' (default) for local development, 'webhook' for production
RUN_MODE=polling

# Webhook Configuration (for production deployment when RUN_MODE=webhook)
# Set to your full webhook URL including the bot token path
# Example: WEBHOOK_URL=https://your-app.onrender.com/123456:ABCdefGHIjklMNOpqrsTUVwxyz
WEBHOOK_URL=
WEBHOOK_SECRET=your_webhook_secret

# Server Port
# Default: 8000 for local webhook testing
# Render will override this with the PORT environment variable
PORT=8000
